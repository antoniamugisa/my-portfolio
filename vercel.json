{
  "rewrites": [
    {
      "source": "/api/opendata/:path*",
      "destination": "https://opendata.toronto.ca/:path*"
    },
    {
      "source": "/api/ckan/:path*",
      "destination": "https://ckan0.cf.opendata.inter.prod-toronto.ca/:path*"
    },
    {
      "source": "/api/gbfs/:path*",
      "destination": "https://tor.publicbikesystem.net/:path*"
    }
  ]
}
