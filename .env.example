# Supabase (blog likes)
# Get these from Supabase dashboard: Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: base URL for Bike Share Parquets (no trailing slash). Needed in production if your
# bucket does not send Access-Control-Allow-Origin; dev uses the Vite proxy automatically.
# VITE_BIKESHARE_PARQUET_BASE=https://your-cdn.example.com
